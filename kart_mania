    funcao cadastrodeKarts(
    		cadeia modelos[],
        	cadeia cores[],
        	cadeia status[],
		real valoresLocacao[],
        	real valorManutencao[],
        	inteiro &quantidadeKarts,
        	inteiro quantidadeLocacao[],
        	logico locado[])
        	{
        		inteiro opcaoStatus = 0

        		se (quantidadeKarts == 15) {
        	
           		escreva("\nLimite Karts atingindo")
            
            		retorne
      		}

        		escreva("Digite o modelo do seu kart:\n ")
        		leia(modelos[quantidadeKarts])
			escreva("Digite a cor do seu Kart:\n")
        		leia(cores[quantidadeKarts])

        		faca {
        		
          		escreva("Digite o valor de locação do seu Kart:\n")
            		leia(valoresLocacao[quantidadeKarts])

          		se (valoresLocacao[quantidadeKarts] > 0) {
                		escreva("\nValor Registrado\n")
                	}senao{
            		
                		escreva("\nNumero incorreto\n")
                		
                	}
            
        		}enquanto(valoresLocacao[quantidadeKarts] <= 0)

        		faca {
          		escreva("Digite o status do seu Kart:\n 1. Usavel \n 2. Em manutenção\n")
          		leia(opcaoStatus)
          		escreva("Valor digitado: ", opcaoStatus, "\n")

            		se (opcaoStatus == 1) {
               		 escreva("\nSalvo para uso\n")
              			 status[quantidadeKarts] = "Usavel"
           		} senao se (opcaoStatus == 2) {
               		 escreva("\nSalvo em manutenção\n")
               		 status[quantidadeKarts] = "Em manuntenção"
				} senao {
               		escreva("\nNumero incorreto\n")
           		}
        		} enquanto (opcaoStatus != 1 e opcaoStatus != 2)

       		locado[quantidadeKarts] = falso
        
        		quantidadeLocacao[quantidadeKarts] = 0
        
        		valorManutencao[quantidadeKarts] = 0.0
       
        		quantidadeKarts = quantidadeKarts + 1

        		escreva("\nO kart foi cadastrado com sucesso")
        		retorne
    		}

    funcao listarKartsDisponiveis(
