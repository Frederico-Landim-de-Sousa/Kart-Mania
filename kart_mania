        cadeia cores[],
        cadeia status[],
        real valoresLocacao[],
        inteiro &quantidadeKarts,
        logico locado[]
    ) {
        logico escolheu = falso
        inteiro i = 0
	
        para (i = 0; i < quantidadeKarts; i++) {
            se (locado[i] == falso e status[i] == "Usavel") {
                escreva(
                    "\nKart: ", i + 1,
                    "\nModelo: ", modelos[i],
                    "\nCor: ", cores[i],
                    "\nValor: R$ \n", valoresLocacao[i]
                )
                escolheu = verdadeiro
            }
        }

        se (escolheu == falso) {
            escreva("\nNenhum Kart Disponível\n")
        }
    }

