    funcao AtualizarDadosKart(	
    	cadeia modelos[],
     cadeia cores[],
     cadeia status[],
     real valoresLocacao[],
     real valorManutencao[],
     inteiro &quantidadeKarts,
     logico locado[]
     )
     {
     	real custoManutencao
     	inteiro opcaoAlterar
     	inteiro i = 0
     	inteiro indice 
     	inteiro opcaoStatus = 0

     	se(quantidadeKarts == 0){
     		
        	escreva("\nNenhum Kart Disponível\n")
        	
        	retorne
        	
        	}
     	
     	para(i = 0; i < quantidadeKarts; i++){
     		
     		escreva(
     			"\nKart: ", i + 1,
                    "\nModelo: ", modelos[i],
                    "\nCor: ", cores[i],
                    "\nValor: R$ \n", valoresLocacao[i]
                	)           	
            }
                    	
        	escreva("Qual kart você deseja alterar informação?\n")
        	leia(indice)
        	indice = indice - 1
        	escreva("\n Valor digitado: ", indice)
        
        	se(indice < 0 ou indice >= quantidadeKarts){
        	
        	escreva("\n Kart inexistente")
        	
        	retorne
        	
        	}
        	
        	faca{
        		
        		escreva(
        			"Qual informação você deseja alterar:\n", 
               	"\n 1.Modelo: ", modelos[indice],
               	"\n 2.Cor: ", cores[indice],
               	"\n 3.Valor: R$ ", valoresLocacao[indice],
               	"\n 4.Status do carro: ", status[indice]
        	  		)
        			
        			leia(opcaoAlterar)
        	  	
				se(opcaoAlterar == 1){
					
					escreva("O modelo atual do carro e ", modelos[indice], " Qual o novo modelo para ser atribuido?\n")
					
					leia(modelos[indice])
					
					escreva("\nModelo atualizado com sucesso\n")
					
					}senao se(opcaoAlterar == 2){
						
						escreva("A cor atual do Kart e :", cores[indice], "Qual o novo cor a ser atribuido: \n")
						
						leia(cores[indice])

						escreva("\nCor atualizado com sucesso\n")
						
        	  			}senao se(opcaoAlterar == 3){
        	  				
        	  			
        	  				escreva("O valor de locação atual e", valoresLocacao[indice], "Qual o novo valor a ser atribuido: \n")
        	  				
        	  				faca{
        	  					
        	  					leia(valoresLocacao[indice])

        	  					

        	  					se(valoresLocacao[indice] <= 0){
        	  						
        	  						escreva("\nO valor de locação digitado e invalido. ")
        	  						
        	  					}
        	  				}enquanto(valoresLocacao[indice] <= 0)

        	  				escreva("\nO valor de locação foi atualizado com sucesso\n")
        	  				
        	  			}senao se(opcaoAlterar == 4){

        	  				faca{
        	  				
        	  				escreva("O status atual do seu carro e", status[indice], "Você deseja modificar para",
        	  				"\n1- Usavel",
        	  				"\n2- Em manutenção"
        	  				)
        	  				leia(opcaoStatus)
        	  				
        	  			se(opcaoStatus == 1) {
        	  				
        	  				se(status[indice] == "Em manuntenção"){
        	  					
            						
    							escreva("\nQuanto foi gasto nesta manutenção? R$ ")
    							faca{
    								
    								leia(custoManutencao)
    							
    								se(custoManutencao < 0){
    									
        								escreva("\nValor invalido")
        								
   								}

								}enquanto(custoManutencao < 0)

   							valorManutencao[indice] = valorManutencao[indice] + custoManutencao

    							
	   						
						}
						
        	  				status[indice] = "Usavel"

	   					escreva("\nSalvo para uso\n")
                			
            				}senao se(opcaoStatus == 2){
            					
            				
            				escreva("\nSalvo em manutenção\n")
            				
                			status[indice] = "Em manuntenção"
                			
                			}senao{
                				
                			escreva("\nNumero incorreto\n")
                			
                			}
            				
        	  			}enquanto(opcaoStatus != 1 e opcaoStatus !=2)
        	  		}
        	
        	}enquanto(opcaoAlterar < 1 ou opcaoAlterar  > 4)
        	}
    		
    		   funcao AlugarKart( 
    		   		
    		   	cadeia modelos[],
  			cadeia cores[],
     		cadeia status[],
     		real valoresLocacao[],
     		inteiro &quantidadeKarts,
     		inteiro quantidadeLocacao[],
     		logico locado[]) {
     			
     			logico encontrou = falso
				inteiro i
				inteiro indice

				para(i = 0; i < quantidadeKarts; i++)
				{
   					 se(locado[i] == falso e status[i] == "Usavel")
    				{
       		 		encontrou = verdadeiro
   				 }
				
				}
					se(encontrou == falso)
				{
    				escreva("\nNenhum kart disponível para locação.\n")
    				
    				retorne
    				
				}
				
     			listarKartsDisponiveis(modelos, cores, status, valoresLocacao, quantidadeKarts, locado)
				
				escreva("\nDigite qual kart você deseja alugar?:\n")
     			leia(indice)
     			indice = indice - 1
     			
     			se(indice < 0 ou indice >= quantidadeKarts){
        	
        				escreva("\n Kart inexistente")
        	
        				retorne
        	
        			}
        			se(locado[indice] == verdadeiro){
        				
        				escreva("O Kart ja está locado")

        				retorne
        			}
        			escreva("\nO kart selecionado foi ", indice+1, ". Agora esta locado\n")
        			locado[indice] = verdadeiro
				quantidadeLocacao[indice] = quantidadeLocacao[indice] + 1
        			
					
     		}
    		
    		funcao DevolverKart(
		cadeia modelos[],
		inteiro &quantidadeKarts,
		logico locado[])
		{
			inteiro indice
			inteiro i
			logico encontrou = falso

			para(i = 0; i < quantidadeKarts; i++)
			{
				se(locado[i] == verdadeiro)
				{
					escreva("\n", i + 1, " - ", modelos[i])
					encontrou = verdadeiro
				}
			}

			se(encontrou == falso)
			{
				escreva("\nNenhum kart está locado.\n")
				retorne
			}

			escreva("\nDigite o número do kart que deseja devolver:\n")
			leia(indice)

			indice = indice - 1

			se(indice < 0 ou indice >= quantidadeKarts)
			{
				escreva("\nKart inexistente.\n")
				retorne
			}

			se(locado[indice] == falso)
			{
				escreva("\nEste kart já está disponível.\n")
				retorne
			}

			locado[indice] = falso

			escreva("\nKart devolvido com sucesso!\n")
		}
		funcao KartMaisGerouGanhos(
		cadeia modelos[],
		cadeia cores[],
		cadeia status[],
		real valoresLocacao[],
		real valorManutencao[],
		inteiro quantidadeLocacao[],
		inteiro &quantidadeKarts,
		logico locado[]
		)
		{
			inteiro i
			inteiro indiceMaior = 0

			real maiorGanho
			real ganhoAtual

			se(quantidadeKarts == 0)
			{
				escreva("\nNenhum kart cadastrado.\n")
				retorne
			}

			maiorGanho = quantidadeLocacao[0] * valoresLocacao[0]

			para(i = 1; i < quantidadeKarts; i++)
			{
				ganhoAtual = quantidadeLocacao[i] * valoresLocacao[i]

				se(ganhoAtual > maiorGanho)
				{
				maiorGanho = ganhoAtual
				indiceMaior = i
				}
			}

			escreva("\n===== KART QUE MAIS GEROU GANHOS =====")
			escreva("\nModelo: ", modelos[indiceMaior])
			escreva("\nCor: ", cores[indiceMaior])
			escreva("\nStatus: ", status[indiceMaior])

			se(locado[indiceMaior])
			{
				escreva("\nSituação: Locado")
			}
			senao
			{
				escreva("\nSituação: Disponível")
			}

			escreva("\nValor da Locação: R$ ", valoresLocacao[indiceMaior])
			escreva("\nQuantidade de Locações: ", quantidadeLocacao[indiceMaior])
			escreva("\nTotal em Manutenção: R$ ", valorManutencao[indiceMaior])
			escreva("\nTotal Arrecadado: R$ ", maiorGanho, "\n")
		}
		funcao ReceitaELucroDoDia(
		real valoresLocacao[],
		logico locado[],
		inteiro &quantidadeKarts,
		real valorCircuito,
		logico circuitoLocado)
		{
			real receita = 0.0
			real lucro = 0.0
			inteiro i

			para(i = 0; i < quantidadeKarts; i++)
			{
				se(locado[i] == verdadeiro)
				{
					receita = receita + valoresLocacao[i]
				}
			}
			se(circuitoLocado == verdadeiro)
			{
				real ganhoCircuito
				ganhoCircuito = valorCircuito * 0.70
				escreva("\nCircuito locado.")
				escreva("\nAcréscimo do circuito: R$ ", ganhoCircuito)
				receita = receita + ganhoCircuito
			}

			lucro = receita * 0.30

			escreva("\n==============================")
			escreva("\nRECEITA E LUCRO DO DIA")
			escreva("\n==============================")
			escreva("\nReceita: R$ ", receita)
			escreva("\nLucro: R$ ", lucro, "\n")
		}
		funcao LocacaoCircuito(
		real &valorCircuito,
		logico &circuitoLocado)
		{

			inteiro opcao

			se(valorCircuito == 0)
			{
				faca
				{
					escreva("\nDigite o valor de locação do circuito: ")
					leia(valorCircuito)


					se(valorCircuito <= 0)
					{
						escreva("\nValor inválido.")
					}

				}enquanto(valorCircuito <= 0)
			}


			se(circuitoLocado == verdadeiro)
			{
				escreva("\nO circuito já está locado.")
				retorne
			}


			escreva("\nValor do circuito: R$ ", valorCircuito)
			escreva("\nDeseja locar o circuito?")
			escreva("\n1 - Sim")
			escreva("\n2 - Não")
			leia(opcao)


			se(opcao == 1)
			{
				circuitoLocado = verdadeiro
				escreva("\nCircuito locado com sucesso!")
			}
		}
		funcao AtualizarDia(
		cadeia modelos[],
		inteiro &quantidadeKarts,
		logico locado[],
		logico &circuitoLocado)
		{
			inteiro i
			logico encontrou = falso


			escreva("\n================================")
			escreva("\nATUALIZANDO DIA")
			escreva("\n================================")


			circuitoLocado = falso

			escreva("\nCircuito liberado para nova locação.\n")


			escreva("\nKarts que precisam de nova cobrança:\n")

			para(i = 0; i < quantidadeKarts; i++)
			{
				se(locado[i] == verdadeiro)
				{
					escreva("- ", modelos[i], "\n")
					encontrou = verdadeiro
				}
			}

		}
